{
  "name": "@nona-takahara/nona-mark",
  "version": "0.1.0",
  "description": "A less strict markup language. Markdown dialect of Nona powered by remark",
  "keywords": [
    "markdown",
    "mdast",
    "remark",
    "remark-plugin",
    "unified"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./petitcom": {
      "types": "./dist/petitcom/index.d.ts",
      "default": "./dist/petitcom/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nona-takahara/nona-mark.git"
  },
  "author": "Nona Takahara",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nona-takahara/nona-mark/issues"
  },
  "homepage": "https://github.com/nona-takahara/nona-mark#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-util-combine-extensions": "^2.0.1",
    "remark-math": "^6.0.0",
    "unified": "^11.0.5",
    "unist-util-is": "^6.0.1",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "mdast-util-to-hast": "^13.2.1",
    "publint": "^0.3.23",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
